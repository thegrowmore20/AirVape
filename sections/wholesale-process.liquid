{% render 'section-bg-number-vars' %}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --wp-accent: {{ section.settings.accent_color }};
    --wp-number-bg: {{ section.settings.number_bg_color }};
  }
</style>

{% liquid
  assign section_classes = ' wp-process '

  if section.settings.remove_horizontal_space
    assign section_classes = section_classes | append: ' !px-0 '
  endif

  if section.settings.remove_vertical_space
    assign section_classes = section_classes | append: ' !py-0 '
  endif

  assign step_cols = section.blocks.size | at_least: 1
  assign half_col_pct = 50.0 | divided_by: step_cols
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header' %}

    {% if section.blocks.size > 0 %}
      <div class="wp-steps grid relative" data-animation-auto-order>
        {% for block in section.blocks %}
          {%- liquid
            assign auto_num = forloop.index | prepend: '0' | slice: -2, 2
            assign num = block.settings.number | default: auto_num
          -%}
          <div
            class="wp-step relative flex flex-col items-center text-center"
            data-animation="block"
            data-animation-group="{{ section.id }}-steps"
            {{ block.shopify_attributes }}
          >
            <div class="wp-step__num flex items-center justify-center">{{ num }}</div>
            {% if block.settings.title != blank %}
              <h3 class="wp-step__title text-base">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="wp-step__text text-sm">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Steps in a single row (structure mirrors affiliate "How it works") */
  .wp-steps {
    grid-template-columns: repeat({{ step_cols }}, 1fr);
    margin-top: 56px;
  }

  /* Connector line running behind the number badges (desktop single row only) */
  .wp-steps::before {
    content: '';
    position: absolute;
    top: 28px;
    left: calc({{ half_col_pct }}% + 28px);
    right: calc({{ half_col_pct }}% + 28px);
    height: 1px;
    background: linear-gradient(90deg, rgb(var(--color-foreground)), rgb(var(--color-foreground) / 0.2), rgb(var(--color-foreground)));
    opacity: 0.3;
    pointer-events: none;
  }

  .wp-step {
    padding: 0 20px;
    z-index: 1;
  }

  /* Circular number badge — gold background kept, now configurable via setting */
  .wp-step__num {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    margin-bottom: 20px;
    flex-shrink: 0;
    font-weight: 700;
    font-size: var(--size-text-base);
    color: #111;
    background: var(--wp-number-bg);
    border: 1px solid var(--wp-number-bg);
  }

  .wp-step__title {
    margin-bottom: 10px;
    color: rgb(var(--color-foreground));
    font-weight: 600;
  }

  .wp-step__text {
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 900px) {
    .wp-steps {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    /* Connector line no longer makes sense once the steps wrap */
    .wp-steps::before { display: none; }
  }

  @media (max-width: 600px) {
    .wp-steps {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "Wholesale Process",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
