      "blocks": [
        { "type": "step", "settings": { "text": "<p>Submit your wholesale inquiry with your business details, product interest, and estimated order quantity.</p>" } },
        { "type": "step", "settings": { "text": "<p>Our team will review your request.</p>" } },
        { "type": "step", "settings": { "text": "<p>Approved wholesale partners may receive selected marketing materials such as product images, descriptions, specifications, and key product information to support sales and promotion.</p>" } }
      ]
    }
  ]
}
{% endschema %}
