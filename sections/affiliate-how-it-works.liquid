{% render 'section-bg-number-vars' %}

{% liquid
  assign bg = section.settings.background_color
  assign text = section.settings.text_color
  assign heading = section.settings.heading_color

  # Auto-pick a readable text colour from the background's brightness,
  # so a dark bg never leaves dark (invisible) text behind.
  assign auto_ch = '0 0 0'
  if bg != blank
    assign bg_brightness = bg | color_brightness
    if bg_brightness < 140
      assign auto_ch = '255 255 255'
    endif
  endif

  # Resolve to space-separated RGB channels (R G B) so they plug into the
  # theme's rgb(var(--x) / alpha) pattern.
  assign bg_ch = ''
  if bg != blank
    assign bg_ch = bg.red | append: ' ' | append: bg.green | append: ' ' | append: bg.blue
  endif

  assign text_ch = ''
  if text != blank
    assign text_ch = text.red | append: ' ' | append: text.green | append: ' ' | append: text.blue
  elsif bg != blank
    assign text_ch = auto_ch
  endif

  assign heading_ch = ''
  if heading != blank
    assign heading_ch = heading.red | append: ' ' | append: heading.green | append: ' ' | append: heading.blue
  elsif bg != blank
    assign heading_ch = auto_ch
  endif
%}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    {%- if bg_ch != blank %}
    --color-background: {{ bg_ch }};
    {%- endif %}
    {%- if text_ch != blank %}
    --color-foreground: {{ text_ch }};
    {%- endif %}
    {%- if heading_ch != blank %}
    --awh-heading: {{ heading_ch }};
    {%- endif %}
  }

  {%- if bg_ch != blank %}
  /* Paint the background only when a colour is chosen (keeps default transparent). */
  #shopify-section-{{ section.id }} .awh-section {
    background-color: rgb(var(--color-background));
  }
  {%- endif %}
</style>

<section id="affiliate-how-it-works" {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header', button: false %}

    <div class="awh-steps relative" data-animation-auto-order>
      {% for i in (1..4) %}
        {% liquid
          assign title_key = 'step_' | append: i | append: '_title'
          assign desc_key = 'step_' | append: i | append: '_description'
          assign step_title = section.settings[title_key]
          assign step_desc = section.settings[desc_key]
        %}
        {% if step_title != blank or step_desc != blank %}
          <div class="awh-step relative" data-animation="block" data-animation-group="{{ section.id }}">
            <div class="awh-step__num">{{ i }}</div>
            {% if step_title != blank %}
              <h4 class="heading {{ section.settings.card_heading_size }} awh-step__title">{{ step_title }}</h4>
            {% endif %}
            {% if step_desc != blank %}
              <p class="awh-step__desc">{{ step_desc }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="awh-cta">
        {% render 'button' %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Vertical/horizontal spacing comes from the theme .section class. */
  .awh-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 56px;
  }

  /* Connector line running behind the number circles (desktop only) */
  .awh-steps::before {
    content: '';
    position: absolute;
    top: 28px;
    left: calc(12.5% + 28px);
    right: calc(12.5% + 28px);
    height: 1px;
    background: linear-gradient(90deg, rgb(var(--color-foreground)), rgb(var(--color-foreground) / 0.2), rgb(var(--color-foreground)));
    opacity: 0.3;
    pointer-events: none;
  }

  .awh-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 20px;
    z-index: 1;
  }

  .awh-step__num {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    /* Solid ink circle: circle = text colour, number = bg colour → inverts on dark. */
    color: rgb(var(--color-background));
    background: #ffbc05;
    border: 1px solid #ffbc05;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    flex-shrink: 0;
    font-size: var(--size-text-base);
    font-weight: 700;
  }
  .awh-step__num:hover {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground));
  }

  .awh-step__title {
    margin-bottom: 10px;
    color: rgb(var(--awh-heading, var(--color-foreground)));
    font-weight: 600;
  }

  .awh-step__desc {
    font-size: var(--size-text-sm);
    line-height: 1.65;
    color: rgb(var(--color-foreground) / 0.65);
    margin: 0;
  }

  .awh-cta {
    display: flex;
    justify-content: center;
    margin-top: 52px;
    
  }
  .awh-cta a {
    transition: all 0.2s ease;
  }
  .awh-cta a:hover {
    background: rgb(var(--color-foreground));;
    color: #000;
  }

  @media (max-width: 900px) {
    .awh-steps {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    /* Connector line doesn't make sense once the steps wrap */
    .awh-steps::before { display: none; }
  }

  @media (max-width: 600px) {

    .awh-steps { 
      grid-template-columns: 1fr; 
      gap: 30px;
    }
    awh-cta {   
      margin-top: 30px;
    }
  }
</style>

