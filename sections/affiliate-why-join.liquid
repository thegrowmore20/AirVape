{% comment %}
  Affiliate · Why join
  ---------------------------------------------------------------------------
  Multi-instance safe. All colours are resolved into CSS custom properties on
  #shopify-section-{{ section.id }} (unique per instance) and the component
  rules only read those variables. So two copies on one page never fight — a
  Light card and a Dark card can sit side by side.

  Controls:
   • Color scheme  → Light (original look) / Dark
   • Card layout   → Stacked (icon on top) / Inline (icon on left)
   • Optional colour overrides (blank = use the scheme's colour)
  ---------------------------------------------------------------------------
{% endcomment %}

{% render 'section-bg-number-vars' %}

{% liquid
  assign scheme = section.settings.color_scheme | default: 'light'

  # Brand colours (scheme-independent, configurable)
  assign brand_yellow = section.settings.brand_yellow_color | default: '#ffffff'

  # ---- Scheme fallbacks -----------------------------------------------------
  if scheme == 'dark'
    assign fb_section_bg    = '#0f0f0f'
    assign fb_card_bg       = '#181818'
    assign fb_card_border   = 'rgba(255, 255, 255, 0.08)'
    assign fb_card_bg_h     = '#232323'
    assign fb_card_border_h = 'rgba(255, 255, 255, 0.45)'
    assign fb_title         = '#ffffff'
    assign fb_title_h       = '#ffffff'
    assign fb_desc          = 'rgba(255, 255, 255, 0.62)'
    assign fb_desc_h        = 'rgba(255, 255, 255, 0.85)'
    assign fb_icon_bg       = '#ffffff'
    assign fb_icon_color    = '#111111'
    assign fb_icon_bg_h     = '#111111'
    assign fb_icon_color_h  = '#ffffff'
    assign fb_tag_bg        = 'rgba(255, 255, 255, 0.08)'
    assign fb_tag_color     = 'rgba(255, 255, 255, 0.80)'
    assign fb_dot_color     = 'rgba(255, 255, 255, 0.7)'
  else
    # Light = the original look, expressed as variables (theme-aware)
    assign fb_section_bg    = 'transparent'
    assign fb_card_bg       = 'rgb(var(--color-background))'
    assign fb_card_border   = '#f5ebeb'
    assign fb_card_bg_h     = 'rgb(var(--color-foreground))'
    assign fb_card_border_h = 'rgb(var(--color-foreground))'
    assign fb_title         = 'rgb(var(--color-foreground))'
    assign fb_title_h       = 'rgb(var(--color-background))'
    assign fb_desc          = 'rgb(var(--color-foreground) / 1)'
    assign fb_desc_h        = 'rgb(var(--color-background))'
    assign fb_icon_bg       = 'rgb(var(--color-foreground))'
    assign fb_icon_color    = 'var(--awj-accent)'
    assign fb_icon_bg_h     = '#ffffff'
    assign fb_icon_color_h  = '#000000'
    assign fb_tag_bg        = '#eeeeee'
    assign fb_tag_color     = '#333333'
    assign fb_dot_color     = 'rgb(var(--color-foreground))'
  endif

  # ---- Optional overrides (blank => use the scheme fallback) -----------------
  assign section_bg = fb_section_bg
  if section.settings.background_color != blank
    assign section_bg = section.settings.background_color
  endif

  assign card_bg = fb_card_bg
  if section.settings.card_background_color != blank
    assign card_bg = section.settings.card_background_color
  endif

  assign icon_bg = fb_icon_bg
  if section.settings.icon_background_color != blank
    assign icon_bg = section.settings.icon_background_color
  endif

  assign icon_color_final = fb_icon_color
  if section.settings.icon_color != blank
    assign icon_color_final = section.settings.icon_color
  endif

  assign awj_pad_bg = false
  if section.settings.remove_vertical_space == false
    if scheme == 'dark' or section.settings.section_bg_color != blank
      assign awj_pad_bg = true
    endif
  endif

%}

<style>
  .awj-section.section--full-width {
    padding-top: min(calc(var(--section-vertical-spacing) * 1), var(--section-pt-max, 9999px));
  }
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --awj-accent: {{ section.settings.accent_color }};
    --awj-accent-rgb: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --awj-brand-yellow: {{ brand_yellow }};

    /* Surfaces */
    --awj-section-bg: {{ section_bg }};
    --awj-card-bg: {{ card_bg }};
    --awj-card-border: {{ fb_card_border }};
    --awj-card-bg-hover: {{ fb_card_bg_h }};
    --awj-card-border-hover: {{ fb_card_border_h }};

    /* Text */
    --awj-title: {{ fb_title }};
    --awj-title-hover: {{ fb_title_h }};
    --awj-desc: {{ fb_desc }};
    --awj-desc-hover: {{ fb_desc_h }};

    /* Icon badge */
    --awj-icon-bg: {{ icon_bg }};
    --awj-icon-color: {{ icon_color_final }};
    --awj-icon-bg-hover: {{ fb_icon_bg_h }};
    --awj-icon-color-hover: {{ fb_icon_color_h }};

    /* Tags */
    --awj-tag-bg: {{ fb_tag_bg }};
    --awj-tag-color: {{ fb_tag_color }};
    --awj-dot-color: {{ fb_dot_color }};
  }
</style>

{% liquid
  assign section_classes = ' awj-section ' | append: scheme
  if section.settings.remove_horizontal_space
    assign section_classes = section_classes | append: ' !px-0 '
  endif
  if section.settings.remove_vertical_space
    assign section_classes = section_classes | append: ' !py-0 '
  endif
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header' %}

    {% if section.blocks.size > 0 %}
      <div class="awj-grid awj-grid-{{ section.id }}" data-animation-auto-order>
        {% for block in section.blocks %}
          <article
            class="awj-card relative overflow-hidden {% if block.settings.title == blank %}awj-card-no-heading{% endif %}"
            data-animation="block"
            data-animation-group="{{ section.id }}-cards"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} Icon: preset SVG, uploaded image, or pasted SVG code {%- endcomment -%}
            {%- assign icon_type = block.settings.icon_type | default: 'preset' -%}
            {%- case icon_type -%}
              {%- when 'image' -%}
                {%- if block.settings.icon_image != blank -%}
                  {% assign icon_sizes = block.settings.icon_width | append: 'px' %}
                  <div class="awj-card__icon" style="width: {{ block.settings.icon_width }}px;">
                    {{
                      block.settings.icon_image
                      | image_url: width: 240
                      | image_tag:
                        widths: '60, 120, 180, 240',
                        sizes: icon_sizes,
                        alt: block.settings.icon_image.alt,
                        loading: 'lazy'
                    }}
                  </div>
                {%- endif -%}
              {%- when 'svg' -%}
                {%- if block.settings.custom_svg != blank -%}
                  <div class="awj-card__icon awj-card__icon--svg">
                    {{ block.settings.custom_svg }}
                  </div>
                {%- endif -%}
              {%- else -%}
                {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                  <div class="awj-card__icon awj-card__icon--svg">
                    {% render 'affiliate-preset-icon', icon: block.settings.icon %}
                  </div>
                {%- endif -%}
            {%- endcase -%}

            <div class="awj-card__content">
              {% if block.settings.title != blank %}
                <h3 class="awj-card__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="awj-card__desc">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.tag_1 != blank or block.settings.tag_2 != blank or block.settings.tag_3 != blank %}
                <div class="column-tags">
                  {% for i in (1..5) %}
                    {% capture tag %}tag_{{ i }}{% endcapture %}
                    {% if block.settings[tag] != blank %}
                      <span>{{ block.settings[tag] }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.bottom_note != blank %}
      <div class="section-bottom-note text-center center mt-8">
        {{ section.settings.bottom_note }}
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Section background (scoped so it only ever paints this instance) */
  #shopify-section-{{ section.id }} .awj-section {
    background: var(--awj-section-bg);
    {% if awj_pad_bg %}padding-block: var(--awj-section-pad, clamp(40px, 5vw, 72px));{% endif %}
  }

  /* Grid — already unique via the section id */
  .awj-grid.awj-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 12px;
    text-align: left;
  }

  /* Card — every colour comes from a variable, so instances never collide */
  .awj-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 15px;
    border-radius: 18px;
    background: var(--awj-card-bg);
    border: 1px solid var(--awj-card-border);
    transition: transform 0.3s ease, box-shadow 0.3s ease,
                background 0.3s ease, border-color 0.3s ease;
    will-change: transform;
  }

  .awj-card:hover {
    background: var(--awj-card-bg-hover);
    border-color: var(--awj-card-border-hover);
  }

  .awj-card:hover .awj-card__title { color: var(--awj-title-hover); }
  .awj-card:hover .awj-card__desc  { color: var(--awj-desc-hover); }

  .awj-card__content { min-width: 0; }

  /* Icon badge */
  .awj-card__icon {
    margin-bottom: 20px;
    max-width: 100%;
  }

  .awj-card__icon img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .awj-card__icon--svg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--awj-icon-bg);
    color: var(--awj-icon-color);
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    font-weight: 600;
  }

  .awj-card__icon--svg svg {
    width: 28px;
    height: 28px;
    display: block;
    fill: currentColor;
  }

  .awj-card:hover .awj-card__icon--svg {
    background: var(--awj-icon-bg-hover);
    color: var(--awj-icon-color-hover);
    transform: scale(1.05);
  }

  .awj-card__title {
    margin-bottom: 5px;
    font-size: var(--size-text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--awj-title);
  }

  .awj-card__desc {
    font-size: var(--size-text-sm);
    line-height: 1.7;
    color: var(--awj-desc);
  }

  .awj-card__desc ul {
    margin-block: 8px;
  }
  .awj-card__desc li {
    list-style: none;
    padding: 4px 0 4px 26px;
    position: relative;
    font-size: 14px;
    border-bottom: 1px solid var(--awj-card-border);
  }
  .awj-card__desc li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--awj-dot-color);
    transform: translateY(-50%);
  }

  .column-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 15px;
  }

  .column-tags > span {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    background: var(--awj-tag-bg);
    color: var(--awj-tag-color);
    border-radius: 999px;
    padding: 7px 14px;
  }

  {%- if section.settings.card_layout == 'inline' -%}
  /* Inline layout: icon on the left, content beside it.
     Scoped to this instance so other copies keep their own layout. */
  #shopify-section-{{ section.id }} .awj-card {
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .awj-card.awj-card-no-heading {
    align-items: center;
  }
  #shopify-section-{{ section.id }} .awj-card__icon { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .awj-card__icon--svg { flex-shrink: 0; }
  #shopify-section-{{ section.id }} .awj-card__content { flex: 1; }
  {%- endif -%}

  @media (max-width: 900px) {
    .awj-grid.awj-grid-{{ section.id }} { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .awj-grid.awj-grid-{{ section.id }} { grid-template-columns: 1fr; }
    .awj-card { padding: 15px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .awj-card, .awj-card__icon--svg { transition: none; }
    .awj-card:hover { transform: none; }
  }
</style>

{% schema %}
{
