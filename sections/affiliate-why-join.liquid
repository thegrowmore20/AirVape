{% render 'section-bg-number-vars' %}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --awj-accent: {{ section.settings.accent_color }};
    --awj-accent-rgb: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
  }
</style>

{% liquid
  assign section_classes = ' awj-section '
  if section.settings.remove_horizontal_space
    assign section_classes = section_classes | append: ' !px-0 '
  endif
  if section.settings.remove_vertical_space
    assign section_classes = section_classes | append: ' !py-0 '
  endif
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header' %}

    {% if section.blocks.size > 0 %}
      <div class="awj-grid" data-animation-auto-order>
        {% for block in section.blocks %}
          <article
            class="awj-card relative overflow-hidden"
            data-animation="block"
            data-animation-group="{{ section.id }}-cards"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} Icon: inline SVG (preset-friendly) OR uploaded image {%- endcomment -%}
            {% if block.settings.icon != blank and block.settings.icon != 'none' %}
              <div class="awj-card__icon awj-card__icon--svg">
                {% case block.settings.icon %}
                  {% when 'commission' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M12 1.5v21M17 5.5H9.5A3.5 3.5 0 0 0 9.5 12.5h5a3.5 3.5 0 0 1 0 7H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% when 'tracking' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M3 20V10M9 20V4M15 20v-7M21 20V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% when 'nominimum' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.6"/>
                      <path d="m8 8 8 8M16 8l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                  {% when 'link' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M9.5 14.5 14.5 9.5M10.5 6.5l1.4-1.4a4 4 0 0 1 5.6 5.6l-1.4 1.4M13.5 17.5l-1.4 1.4a4 4 0 0 1-5.6-5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% when 'support' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M4 5h13a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-4 3.5V16H4a1 1 0 0 1-1-1V7a2 2 0 0 1 1-2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="M8 9.5h7M8 12.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                  {% when 'product' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M12 2.5 4 6.5v6c0 5 3.4 7.9 8 9 4.6-1.1 8-4 8-9v-6l-8-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="m9 12 2.2 2.2L15.5 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% when 'payout' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect x="2.75" y="6.75" width="18.5" height="12.5" rx="2" stroke="currentColor" stroke-width="1.6"/>
                      <path d="M2.75 10.5h18.5" stroke="currentColor" stroke-width="1.6"/>
                      <circle cx="17" cy="14.5" r="1.4" fill="currentColor"/>
                    </svg>
                  {% when 'promote' %}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M3.5 9.5v5a1 1 0 0 0 1 1H8l7 4.5V4L8 8.5H4.5a1 1 0 0 0-1 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                      <path d="M18.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                {% endcase %}
              </div>
            {% elsif block.settings.icon_image != blank %}
              {% assign icon_sizes = block.settings.icon_width | append: 'px' %}
              <div class="awj-card__icon" style="width: {{ block.settings.icon_width }}px;">
                {{
                  block.settings.icon_image
                  | image_url: width: 240
                  | image_tag:
                    widths: '60, 120, 180, 240',
                    sizes: icon_sizes,
                    alt: block.settings.icon_image.alt,
                    loading: 'lazy'
                }}
              </div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="awj-card__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="awj-card__desc">{{ block.settings.text }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Vertical/horizontal spacing comes from the theme .section class. */
  .awj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    text-align: left;
  }

  .awj-card {
    position: relative;
    padding: 15px;
    border-radius: 18px;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground) / 0.10);
    border-color: #f5ebeb;
    transition: transform 0.3s ease, box-shadow 0.3s ease,
                background 0.3s ease, border-color 0.3s ease;
    will-change: transform;
  }

  .awj-card:hover {
    background: rgb(var(--color-foreground));
  }

  .awj-card:hover .awj-card__title,
  .awj-card:hover .awj-card__desc {
    color: rgb(var(--color-background));
  }

  .awj-card:hover::before { transform: scaleY(1); }

  /* Icon badge — soft gold tile that inverts to solid gold on hover */
  .awj-card__icon {
    margin-bottom: 20px;
    max-width: 100%;
  }

  .awj-card__icon img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .awj-card__icon--svg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: rgb(var(--awj-accent-rgb) / 0.12);
    background: rgb(var(--color-foreground));
    color: rgb(var(--awj-accent-rgb));
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .awj-card__icon--svg svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  .awj-card:hover .awj-card__icon--svg {
    {% comment %} background: rgb(var(--awj-accent-rgb)); {% endcomment %}
     background: rgb(251, 188, 5);
    color: rgb(var(--color-background));
    transform: scale(1.05);
  }

  .awj-card__title {
    margin-bottom: 12px;
    font-size: var(--size-text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgb(var(--color-foreground));
  }

  .awj-card__desc {
    font-size: var(--size-text-sm);
    line-height: 1.7;
    color: rgb(var(--color-foreground) / 0.65);
  }

  @media (max-width: 900px) {
    .awj-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .awj-grid { grid-template-columns: 1fr; }
    .awj-card { padding: 28px 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .awj-card, .awj-card::before, .awj-card__icon--svg { transition: none; }
    .awj-card:hover { transform: none; }
  }
</style>

{% schema %}
{
  "name": "Affiliate · Why join",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
      "default": true
