{% render 'section-bg-number-vars' %}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --avw-accent: {{ section.settings.accent_color }};
  }
</style>

{% liquid
  assign section_classes = ' avw-section '

  if section.settings.remove_horizontal_space
    assign section_classes = section_classes | append: ' !px-0 '
  endif

  if section.settings.remove_vertical_space
    assign section_classes = section_classes | append: ' !py-0 '
  endif
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header' %}

    {% if section.blocks.size > 0 %}
      <div class="avw-req-rows flex flex-col gap-4" data-animation-auto-order>
        {% for block in section.blocks %}
          {%- liquid
            assign auto_num = forloop.index | prepend: '0' | slice: -2, 2
            assign num = block.settings.number | default: auto_num
          -%}
          <div
            class="avw-req-row flex items-start gap-6 rounded-block"
            data-animation="block"
            data-animation-group="{{ section.id }}-rows"
            {{ block.shopify_attributes }}
          >
            <div class="avw-req-row-num w-12 h-12 font-bold text-base flex items-center justify-center rounded-full shrink-0">{{ num }}</div>

            <div class="avw-req-row-body flex-1">
              {% if block.settings.title != blank %}
                <div class="avw-req-row-head mb-2">
                  <h3 class="m-0 text-lg font-600">{{ block.settings.title }}</h3>
                </div>
              {% endif %}

              {% if block.settings.content != blank %}
                <div class="avw-req-row-content text-sm">
                  {{ block.settings.content }}
                </div>
              {% endif %}

              {% if block.settings.chips != blank %}
                <div class="avw-chip-row flex flex-wrap gap-2">
                  {% assign chip_items = block.settings.chips | newline_to_br | split: '<br />' %}
                  {% for chip in chip_items %}
                    {% assign chip_label = chip | strip %}
                    {% if chip_label != blank %}
                      <span class="avw-chip text-xs md:text-sm rounded-full">{{ chip_label }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if block.settings.note != blank %}
                <p class="avw-req-note text-sm font-600">{{ block.settings.note }}</p>
              {% endif %}

              {% if block.settings.badge != blank %}
                <span class="avw-badge inline-block text-xs md:text-sm rounded-full mt-3">{{ block.settings.badge }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Card — theme background + subtle theme border (corner radius via .rounded-block) */
  .avw-req-row {
    background: #ffffff;
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    padding: 30px 32px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;

    &:hover{
      box-shadow: 0 10px 26px rgb(var(--color-foreground) / 0.08);
    }
  }

  /* Number badge — inverted theme colors (foreground bg / background text) */
  .avw-req-row-num {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  /* min-width:0 has no theme utility (keeps long text from overflowing the flex row) */
  .avw-req-row-body {
    min-width: 0;
  }

  .avw-req-row-body p {
    margin: 0 0 10px;
    max-width: 720px;
  }
co
  .avw-chip-row {
    margin: 2px 0 12px;
  }

  .avw-chip {
    background: rgb(var(--color-foreground) / 0.05);
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    padding: 6px 14px;  
  }

  /* Badge — inverted theme colors (corner radius via .rounded-block-sm) */
  .avw-badge {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    padding: 10px 14px;
    
  }

  @media (max-width: 700px) {
    .avw-req-row {
      flex-direction: column;
      padding: 24px 22px;
      gap: 14px;
    }
  }
</style>

{% schema %}
{
