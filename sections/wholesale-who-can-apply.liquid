{% render 'section-bg-number-vars' %}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --avw-accent: {{ section.settings.accent_color }};
  }
</style>

{% liquid
  assign section_classes = ' avw-section '

  if section.settings.remove_horizontal_space
    assign section_classes = section_classes | append: ' !px-0 '
  endif

  if section.settings.remove_vertical_space
    assign section_classes = section_classes | append: ' !py-0 '
  endif
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header' %}

    {% if section.blocks.size > 0 %}
      <div class="avw-list-grid grid grid-cols-2" data-animation-auto-order>
        {% for block in section.blocks %}
          <div
            class="avw-list-card flex items-center gap-4"
            data-animation="block"
            data-animation-group="{{ section.id }}-cards"
            {{ block.shopify_attributes }}
          >
            <div class="avw-icon-wrap flex items-center justify-center shrink-0" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'businesses' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M3 13h18"></path></svg>
                {% when 'distributors' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="12" height="8" rx="1"></rect><path d="M14 10h4l3 3v2h-7z"></path><circle cx="6" cy="18" r="1.6"></circle><circle cx="17" cy="18" r="1.6"></circle></svg>
                {% when 'resellers' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9l1-5h14l1 5"></path><path d="M4 9v9a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"></path><path d="M9 19v-6h6v6"></path></svg>
                {% when 'retailers' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"></path><path d="M3 13l9 5 9-5"></path></svg>
                {% when 'smoke_shops' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h11a3 3 0 1 0-3-3"></path><path d="M4 16h13a3 3 0 1 1-3 3"></path></svg>
                {% when 'check' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg>
              {% endcase %}
            </div>

            {% if block.settings.label != blank %}
              <p class="avw-card-label flex-1 m-0">{{ block.settings.label }}</p>
            {% endif %}

            <svg class="avw-list-arrow shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_note and section.settings.note_text != blank %}
      <div class="avw-note flex items-start" data-animation="block" data-animation-group="{{ section.id }}-note">
        <div class="avw-note-icon shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11h1v6"></path></svg>
        </div>
        <div class="avw-note-text">{{ section.settings.note_text }}</div>
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Eyebrow (theme .subheading) tinted with the accent color */
  .avw-section .subheading {
    color: var(--avw-accent);
  }

  /* gap:14px and margin-bottom:28px have no exact theme utility */
  .avw-list-grid {
    gap: 14px;
    margin-bottom: 28px;
  }

  .avw-list-card {
    background: #fff;
    border: 1px solid #e4e4e4;
    border-radius: 14px;
    padding: 16px 20px;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  /* Lift via box-shadow only (no translateY) so hover can't jitter at the edges */
  .avw-list-card:hover {
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    border-color: var(--avw-accent);
  }

  .avw-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #111;
    color: var(--avw-accent);
  }

  .avw-icon-wrap svg {
    width: 22px;
    height: 22px;
  }

  .avw-card-label {
    font-size: 15.5px;
    font-weight: 600;
    color: #111;
  }

  .avw-list-arrow {
    width: 18px;
    height: 18px;
    color: #c9c9c9;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .avw-list-card:hover .avw-list-arrow {
    color: var(--avw-accent);
    transform: translateX(3px);
  }

  .avw-note {
    gap: 14px;
    background: #fff;
    border: 1px solid #ececec;
    border-left: 4px solid var(--avw-accent);
    border-radius: 12px;
    padding: 20px 22px;
  }

  .avw-note-icon {
    width: 26px;
    height: 26px;
    color: var(--avw-accent);
    margin-top: 2px;
  }

  .avw-note-text,
  .avw-note-text p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: #333;
  }

  @media (max-width: 900px) {
    .avw-list-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Wholesale · Who can apply",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_horizontal_space",
      "label": "t:sections.apps.settings.remove_horizontal_space.label"
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_space",
      "label": "t:sections.apps.settings.remove_vertical_space.label"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.rich-text.settings.content_width.label",
      "options": [
        { "value": "small", "label": "t:sections.rich-text.settings.content_width.options__0.label" },
        { "value": "normal", "label": "t:sections.rich-text.settings.content_width.options__1.label" },
        { "value": "large", "label": "t:sections.rich-text.settings.content_width.options__2.label" },
        { "value": "extra-large", "label": "t:sections.rich-text.settings.content_width.options__3.label" },
        { "value": "full-width", "label": "t:sections.rich-text.settings.content_width.options__4.label" }
      ],
      "default": "large"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c9a24b"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "Eligibility"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label",
      "default": "Who Can Apply?"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:sections.all.content.label",
      "default": "<p>Wholesale applications are open to qualified:</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.text_alignment.label",
      "options": [
        { "value": "text-left", "label": "t:sections.all.text_alignment.options.text_left.label" },
        { "value": "text-center", "label": "t:sections.all.text_alignment.options.text_center.label" }
      ],
      "default": "text-left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        { "value": "h0", "label": "t:sections.all.heading_size.options__0.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h2", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h3", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "h4", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "h5", "label": "t:sections.all.heading_size.options__5.label" },
        { "value": "h6", "label": "t:sections.all.heading_size.options__6.label" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_html_tag",
      "label": "t:sections.all.heading_html_tag.label",
      "options": [
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" },
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2",
      "info": "t:sections.all.heading_html_tag.info"
    },
    {
      "type": "header",
      "content": "Note"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note",
      "default": true
    },
    {
      "type": "richtext",
      "id": "note_text",
      "label": "Note text",
      "default": "<p><strong>Individuals may also apply</strong>, but approval depends on order volume, sales channel, and business intent. Business applicants are generally preferred for long-term wholesale partnerships.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.all.text_color.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.all.heading_color.label"
    }
  ],
  "blocks": [
    {
      "type": "partner_type",
      "name": "Partner type",
      "limit": 12,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "businesses", "label": "Businesses" },
            { "value": "distributors", "label": "Distributors" },
            { "value": "resellers", "label": "Resellers" },
            { "value": "retailers", "label": "Retailers" },
            { "value": "smoke_shops", "label": "Smoke shops" },
            { "value": "check", "label": "Check / Other" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Partner type"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale · Who can apply",
      "category": "Wholesale",
      "blocks": [
        { "type": "partner_type", "settings": { "icon": "businesses", "label": "Businesses" } },
        { "type": "partner_type", "settings": { "icon": "distributors", "label": "Distributors" } },
        { "type": "partner_type", "settings": { "icon": "resellers", "label": "Resellers" } },
        { "type": "partner_type", "settings": { "icon": "retailers", "label": "Retailers" } },
        { "type": "partner_type", "settings": { "icon": "smoke_shops", "label": "Smoke Shops" } },
        { "type": "partner_type", "settings": { "icon": "check", "label": "Other Serious Trade Partners" } }
      ]
    }
  ]
}
{% endschema %}
