{% render 'section-bg-number-vars' %}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --avw-accent: {{ section.settings.accent_color }};
    --avw-icon-size: {% if section.settings.icon_size == 'custom' %}{{ section.settings.icon_size_custom }}px{% else %}{{ section.settings.icon_size }}{% endif %};
  }
</style>

{% liquid
  assign section_classes = ' avw-section '

  if section.settings.remove_horizontal_space
    assign section_classes = section_classes | append: ' !px-0 '
  endif

  if section.settings.remove_vertical_space
    assign section_classes = section_classes | append: ' !py-0 '
  endif
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header', button: false %}

    {% if section.blocks.size > 0 %}
      <div class="avw-list-grid grid grid-cols-2 lg:grid-cols-2 gap-3 mb-6" data-animation-auto-order>
        {% for block in section.blocks %}
          <div
            class="avw-list-card flex items-center gap-4 rounded-block"
            data-animation="block"
            data-animation-group="{{ section.id }}-cards"
            {{ block.shopify_attributes }}
          >
            <div class="avw-icon-wrap flex items-center justify-center shrink-0 rounded-block-sm" aria-hidden="true">
              {%- case block.settings.icon_type -%}
                {%- when 'image' -%}
                  {%- if block.settings.custom_image != blank -%}
                    <img
                      class="avw-icon-img"
                      src="{{ block.settings.custom_image | image_url: width: 88 }}"
                      alt="{{ block.settings.label | escape }}"
                      width="24"
                      height="24"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- when 'svg' -%}
                  {{ block.settings.custom_svg }}
                {%- else -%}
                  {% case block.settings.icon %}
                    {% when 'businesses' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M3 13h18"></path></svg>
                    {% when 'distributors' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="12" height="8" rx="1"></rect><path d="M14 10h4l3 3v2h-7z"></path><circle cx="6" cy="18" r="1.6"></circle><circle cx="17" cy="18" r="1.6"></circle></svg>
                    {% when 'resellers' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9l1-5h14l1 5"></path><path d="M4 9v9a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9"></path><path d="M9 19v-6h6v6"></path></svg>
                    {% when 'retailers' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"></path><path d="M3 13l9 5 9-5"></path></svg>
                    {% when 'smoke_shops' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h11a3 3 0 1 0-3-3"></path><path d="M4 16h13a3 3 0 1 1-3 3"></path></svg>
                    {% when 'check' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg>
                  {% endcase %}
              {%- endcase -%}
            </div>

            {% if block.settings.label != blank %}
              <p class="avw-card-label flex-1 m-0 text-base font-600">{{ block.settings.label }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_note and section.settings.note_text != blank %}
      <div class="avw-note flex items-start rounded-block" data-animation="block" data-animation-group="{{ section.id }}-note">
        <div class="avw-note-icon shrink-0 w-7 h-7" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01"></path><path d="M11 11h1v6"></path></svg>
        </div>
        <div class="avw-note-text text-sm">{{ section.settings.note_text }}</div>
      </div>
    {% endif %}

    {% if section.settings.small_line != blank %}
      <div class="avw-small-line text-base mt-6 text-center mb-0" data-animation="block" data-animation-group="{{ section.id }}-small">{{ section.settings.small_line }}</div>
    {% endif %}

    {% if section.settings.show_footer %}
      <div class="avw-footer-cta flex items-center justify-between gap-6 rounded-block mt-6" data-animation="block" data-animation-group="{{ section.id }}-footer">
        {% if section.settings.footer_heading != blank %}
          <h3 class="avw-footer-heading m-0 text-lg font-600">{{ section.settings.footer_heading }}</h3>
        {% endif %}
        <div class="avw-footer-btn shrink-0">
          {% render 'button', target: section %}
        </div>
      </div>
    {% endif %}

  </div>
</section>

<style>

.avw-icon-wrap {
    width: calc(var(--avw-icon-size) + 22px);
    height: calc(var(--avw-icon-size) + 22px);
    background: rgb(var(--color-foreground));
    color: var(--avw-accent);
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;

    svg {
      width: var(--avw-icon-size);
      height: var(--avw-icon-size);
      fill: var(--avw-accent);
    }
    svg g {
      stroke: var(--avw-accent);
    }

  }

  .avw-list-card {
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    padding: 16px 20px;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;

    &:hover{   
      background: rgb(var(--color-foreground));
      border-color: rgb(var(--color-foreground));
      box-shadow: 0 12px 30px rgb(var(--color-foreground) / 0.18);
    }

    &:hover .avw-card-label {
      color: rgb(var(--color-background));
    }

    &:hover .avw-icon-wrap {
      background: var(--avw-accent);
      color: rgb(var(--color-background));
    }
    &:hover .avw-icon-wrap svg#resellers path,
    &:hover .avw-icon-wrap svg {
     fill: rgb(var(--color-foreground))
    }
    &:hover .avw-icon-wrap svg g {
     stroke: rgb(var(--color-foreground))
    }
    &:hover .avw-icon-wrap svg g path {
     fill: rgb(var(--color-foreground))
    }
    
  }


  .avw-icon-img {
    width: var(--avw-icon-size);
    height: var(--avw-icon-size);
    object-fit: contain;
  }

  .avw-card-label {
    transition: color 0.2s ease;
  }
  .avw-note {
    gap: 14px;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    border-left: 4px solid #999999;
    padding: 20px 22px;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;

    &:hover{
      background: rgb(var(--color-foreground));
      border-color: rgb(var(--color-foreground));
      border-left-color: var(--avw-accent);
      box-shadow: 0 12px 30px rgb(var(--color-foreground) / 0.18);
    }

    &:hover .avw-note-text,
    &:hover .avw-note-text p  {
      color: rgb(var(--color-background));
    }

    &:hover .avw-note-icon {
      color: var(--avw-accent);
    }
  }

  .avw-note-icon {
    color: rgb(var(--color-foreground));
    margin-top: 2px;
    transition: color 0.2s ease;
  }


  .avw-note-text,
  .avw-note-text p {
    margin: 0;
    line-height: 1.6;
    transition: color 0.2s ease;
  }

  .avw-footer-cta {
    background: rgb(var(--color-foreground));
    padding: 26px 34px;
  }

  .avw-footer-heading {
    color: rgb(var(--color-background));
  }

  .avw-footer-btn .button:hover {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  @media (max-width: 900px) {
    .avw-list-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .avw-footer-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px 22px;
    }

    .avw-note{
      padding: 15px 10px;
    }
    .avw-list-card {
      padding: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Wholesale · Who can apply",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_horizontal_space",
      "label": "t:sections.apps.settings.remove_horizontal_space.label"
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_space",
      "label": "t:sections.apps.settings.remove_vertical_space.label"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.rich-text.settings.content_width.label",
      "options": [
        { "value": "small", "label": "t:sections.rich-text.settings.content_width.options__0.label" },
        { "value": "normal", "label": "t:sections.rich-text.settings.content_width.options__1.label" },
        { "value": "large", "label": "t:sections.rich-text.settings.content_width.options__2.label" },
        { "value": "extra-large", "label": "t:sections.rich-text.settings.content_width.options__3.label" },
        { "value": "full-width", "label": "t:sections.rich-text.settings.content_width.options__4.label" }
      ],
      "default": "large"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c9a24b"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "select",
      "id": "icon_size",
      "label": "Icon size",
      "info": "Uses the theme icon sizes. Choose Custom to set an exact pixel size. The tile grows with the icon.",
      "options": [
        { "value": "1rem", "label": "Extra small · icon-xs (16px)" },
        { "value": "1.25rem", "label": "Small · icon-sm (20px)" },
        { "value": "1.5rem", "label": "Medium · icon-md (24px)" },
        { "value": "3rem", "label": "Large · icon-xl (48px)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "1.5rem"
    },
    {
      "type": "range",
      "id": "icon_size_custom",
      "label": "Custom icon size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.icon_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "Eligibility"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label",
      "default": "Who Can Apply?"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:sections.all.content.label",
      "default": "<p>Wholesale applications are open to qualified:</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.text_alignment.label",
      "options": [
        { "value": "text-left", "label": "t:sections.all.text_alignment.options.text_left.label" },
        { "value": "text-center", "label": "t:sections.all.text_alignment.options.text_center.label" }
      ],
      "default": "text-left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        { "value": "h0", "label": "t:sections.all.heading_size.options__0.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h2", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h3", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "h4", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "h5", "label": "t:sections.all.heading_size.options__5.label" },
        { "value": "h6", "label": "t:sections.all.heading_size.options__6.label" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_html_tag",
      "label": "t:sections.all.heading_html_tag.label",
      "options": [
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" },
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2",
      "info": "t:sections.all.heading_html_tag.info"
    },
    {
      "type": "header",
      "content": "Note"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note",
      "default": true
    },
    {
      "type": "richtext",
      "id": "note_text",
      "label": "Note text",
      "default": "<p><strong>Individuals may also apply</strong>, but approval depends on order volume, sales channel, and business intent. Business applicants are generally preferred for long-term wholesale partnerships.</p>"
