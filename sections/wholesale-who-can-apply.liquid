    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.rich-text.blocks.button.settings.button_size.label",
      "options": [
        { "value": "text-xs md:text-sm", "label": "t:sections.rich-text.blocks.button.settings.button_size.options__0.label" },
        { "value": "text-sm md:text-base", "label": "t:sections.rich-text.blocks.button.settings.button_size.options__1.label" },
        { "value": "text-base md:text-lg", "label": "t:sections.rich-text.blocks.button.settings.button_size.options__2.label" },
        { "value": "text-lg md:text-h5", "label": "t:sections.rich-text.blocks.button.settings.button_size.options__3.label" }
      ],
      "default": "text-sm md:text-base"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.all.background_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.all.text_color.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.all.heading_color.label"
    }
