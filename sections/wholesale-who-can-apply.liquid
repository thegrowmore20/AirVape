    {
      "type": "header",
      "content": "Footer CTA"
    },
    {
      "type": "richtext",
      "id": "small_line",
      "label": "Small line",
      "info": "Small italic line shown above the footer CTA.",
      "default": "<p>Providing complete and accurate information helps us review your request more efficiently.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show footer CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_heading",
      "label": "Footer heading",
      "default": "Ready to partner with AirVape?"
    },
    {
      "type": "checkbox",
      "id": "enable_form_popup",
      "label": "Enable Form Popup",
      "default": false
    },
    {
      "type": "html",
      "id": "hulk_form_id_block",
      "label": "Hulk Form Code",
      "visible_if": "{{ section.settings.enable_form_popup }}"
    },
    {
      "type": "text",
