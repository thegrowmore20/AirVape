{% comment %} sections/why-promote.liquid {% endcomment %}
{% render 'section-bg-number-vars' %}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --awj-accent: {{ section.settings.accent_color }};
    --awj-accent-rgb: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
    --gold: {{ section.settings.accent_color }};
    --gold-light: {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
    {% if section.settings.text_color != blank %}--wp-text: {{ section.settings.text_color }};{% endif %}
    {% if section.settings.heading_color != blank %}--wp-heading: {{ section.settings.heading_color }};{% endif %}
  }
</style>

{% liquid
  assign section_classes = ' awj-section why-promote '
  
  if section.settings.remove_horizontal_space
  assign section_classes = section_classes | append: ' !px-0 '
  endif
  if section.settings.remove_vertical_space
  assign section_classes = section_classes | append: ' !py-0 '
  endif
  
  assign stat_count = 0
  assign feature_count = 0
  for block in section.blocks
  if block.type == 'stat'
  assign stat_count = stat_count | plus: 1
  elsif block.type == 'feature'
  assign feature_count = feature_count | plus: 1
  endif
  endfor
  
  assign show_visual = false
  if section.settings.show_big_card or stat_count > 0
  assign show_visual = true
  endif
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header', button: false %}
    
    <div class="why-grid{% unless show_visual %} why-grid--single{% endunless %}">
      
      {%- comment -%} LEFT: heading + feature list {%- endcomment -%}
      <div class="why-content {{ section.settings.text_alignment }}">
        
        
        {% if feature_count > 0 %}
          <ul class="why-list" data-animation-auto-order>
            {% for block in section.blocks %}
              {% if block.type == 'feature' %}
                <li class="why-item" data-animation="block" {{ block.shopify_attributes }}>
                  {%- comment -%} Icon: emoji, preset SVG, uploaded image, or pasted SVG code {%- endcomment -%}
                  {%- assign icon_type = block.settings.icon_type | default: 'emoji' -%}
                  <div class="why-item-icon">
                    {%- case icon_type -%}
                      {%- when 'image' -%}
                        {%- if block.settings.icon_image != blank -%}
                          {{ block.settings.icon_image | image_url: width: 76 | image_tag: widths: '38, 76', sizes: '38px', alt: block.settings.icon_image.alt, loading: 'lazy' }}
                        {%- endif -%}
                      {%- when 'svg' -%}
                        {{ block.settings.custom_svg }}
                      {%- when 'preset' -%}
                        {% render 'affiliate-preset-icon', icon: block.settings.preset_icon %}
                      {%- else -%}
                        {{ block.settings.icon }}
                    {%- endcase -%}
                  </div>
                  <div>
                    {% if block.settings.title != blank %}<div class="why-item-title">{{ block.settings.title }}</div>{% endif %}
                    {% if block.settings.text != blank %}<div class="why-item-desc">{{ block.settings.text }}</div>{% endif %}
                  </div>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
      
      {%- comment -%} RIGHT: highlight card + stat grid {%- endcomment -%}
      {% if show_visual %}
        <div class="why-visual">
          {% if section.settings.show_big_card %}
            <div class="why-big-card">
              {% if section.settings.big_number != blank %}<div class="why-big-num">{{ section.settings.big_number }}</div>{% endif %}
              {% if section.settings.big_label != blank %}<div class="why-big-label">{{ section.settings.big_label }}</div>{% endif %}
              {% if section.settings.big_sub != blank %}<div class="why-big-sub">{{ section.settings.big_sub | newline_to_br }}</div>{% endif %}
            </div>
          {% endif %}
          
          {% if stat_count > 0 %}
            <div class="why-minis" data-animation-auto-order>
              {% for block in section.blocks %}
                {% if block.type == 'stat' %}
                  <div class="why-mini" data-animation="block" {{ block.shopify_attributes }}>
                    {% if block.settings.number != blank %}<div class="why-mini-num">{{ block.settings.number }}</div>{% endif %}
                    {% if block.settings.label != blank %}<div class="why-mini-label">{{ block.settings.label }}</div>{% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
      
    </div>
  </div>
</section>

{% stylesheet %}
/* ===== WHY PROMOTE ===== */
.why-promote .why-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.why-promote .why-grid--single{grid-template-columns:1fr;max-width:760px;margin:0 auto}
.why-promote .why-content{min-width:0;color:var(--wp-text, inherit)}
.why-promote .section-title{color:var(--wp-heading, inherit)}
.why-promote .why-sub{margin-bottom:32px}

.why-promote .why-list{display:flex;flex-direction:column;gap:14px;list-style:none;margin:0;padding:0}
.why-promote .why-item{transition:all 0.2s ease;display:flex;align-items:flex-start;gap:14px;padding:18px 22px;
  border-radius:14px;background:var(--gray-light);text-align:left;border:1px solid #f5ebeb;}
.why-promote .why-item:hover{background:rgb(var(--color-foreground));}
.why-promote .why-item:hover .why-item-title,
.why-promote .why-item:hover .why-item-desc {
  color: rgb(var(--color-background))
}
.why-promote .why-item:hover .why-item-icon {
  background: #ffffff;
}
.why-promote .why-item-icon{width:44px;height:44px;background:#000;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;line-height:1;flex-shrink:0;margin-top:2px;overflow:hidden}
.why-promote .why-item-icon img{width:100%;height:100%;object-fit:contain;padding:7px}
/* Preset / pasted SVG icons: white on the black tile, dark once the tile flips gold */
.why-promote .why-item-icon svg{width:22px;height:22px;display:block;color:#fff;fill:#ffffff;transition:color 0.2s ease}
.why-promote .why-item:hover .why-item-icon svg{color:#000;fill:#000}
.why-promote .why-item-title{font-size:14px;font-weight:800;margin-bottom:3px}
.why-promote .why-item-desc{font-size:12px;color:var(--gray-text);line-height:1.5}
.why-promote .why-item-desc p{margin:0}

.why-promote .why-visual{display:flex;flex-direction:column;gap:16px}
.why-promote .why-big-card{background:rgb(var(--black));border-radius:22px;padding:38px 32px;text-align:center;color:var(--white)}
.why-promote .why-big-num{font-size:80px;font-weight:900;color:#ffffff;line-height:1;letter-spacing:-.04em}
.why-promote .why-big-label{font-size:13px;color:rgba(255,255,255,1);margin-top:6px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.why-promote .why-big-sub{font-size:14px;color:rgba(255,255,255,.6);margin-top:8px;line-height:1.5}

.why-promote .why-minis{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.why-promote .why-mini{background:#f5f5f5;border-radius:16px;padding:20px;text-align:center}
.why-promote .why-mini:hover{background:#000;color:#fff;}
.why-promote .why-mini-num{font-size:26px;font-weight:900;color:var(--black)}
.why-promote .why-mini-label{font-size:10px;color:var(--gray-text);font-weight:700;letter-spacing:.07em;text-transform:uppercase;margin-top:5px}

/* ===== RESPONSIVE ===== */
@media (max-width:1100px){
  .why-promote .why-grid{gap:40px}
  .why-promote .why-big-num{font-size:66px}
}
@media (max-width:900px){
  .why-promote .why-grid{grid-template-columns:1fr;gap:36px}
  .why-promote .why-visual{max-width:560px;width:100%}
}
@media (max-width:600px){
  .why-promote .section-title br{display:none}
  .why-promote .why-sub{margin-bottom:24px}
  .why-promote .why-list{gap:12px}
  .why-promote .why-item{padding:15px;gap:12px}
  .why-promote .why-item-title{font-size:13.5px}
  .why-promote .why-big-card{padding:30px 22px;border-radius:18px}
  .why-promote .why-big-num{font-size:58px}
  .why-promote .why-minis{gap:12px}
  .why-promote .why-mini{padding:18px 14px}
  .why-promote .why-mini-num{font-size:23px}
}
@media (max-width:380px){
  .why-promote .why-minis{grid-template-columns:1fr}
  .why-promote .why-big-num{font-size:52px}
}
{% endstylesheet %}

