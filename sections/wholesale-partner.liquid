{% render 'section-bg-number-vars' %}

<style>
  #shopify-section-{{ section.id }} {
    --content-width: {% render 'get-content-width', type: section.settings.content_width %};
    --awj-accent: {{ section.settings.accent_color }};
    --awj-accent-rgb: {{ section.settings.accent_color.red }} {{ section.settings.accent_color.green }} {{ section.settings.accent_color.blue }};
  }
</style>

{% liquid
  assign section_classes = ' awj-section '

  if section.settings.remove_horizontal_space
    assign section_classes = section_classes | append: ' !px-0 '
  endif

  if section.settings.remove_vertical_space
    assign section_classes = section_classes | append: ' !py-0 '
  endif
%}

<section {% render 'section-attrs', class: section_classes %}>
  <div class="section-body max-w-[--content-width] mx-auto">

    {% render 'section-header' %}

    {% if section.blocks.size > 0 %}
      <div class="awj-grid grid gap-5 text-left" data-animation-auto-order>
        {% for block in section.blocks %}
          <article
            class="awj-card relative overflow-hidden"
            data-animation="block"
            data-animation-group="{{ section.id }}-cards"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.icon_image != blank %}
              {% assign icon_sizes = block.settings.icon_width | append: 'px' %}
              <div class="awj-card__icon inline-flex items-center justify-center mb-5">
                {{
                  block.settings.icon_image
                  | image_url: width: 240
                  | image_tag:
                    class: 'block w-full object-contain',
                    widths: '60, 120, 180, 240',
                    sizes: icon_sizes,
                    alt: block.settings.icon_image.alt,
                    loading: 'lazy'
                }}
              </div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="awj-card__title text-base">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="awj-card__desc text-sm">{{ block.settings.text }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* Vertical/horizontal spacing comes from the theme .section class. */
  /* display/gap/text-align via utilities: .grid .gap-5 .text-left */
  .awj-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  /* A lone last card (odd total count, e.g. the 5th) spans both columns and centres,
     keeping the width of a single column (gap-5 = 20px, so half-gap = 10px). */
  .awj-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    max-width: calc(50% - 10px);
    margin-inline: auto;
  }

  .awj-section{
    padding-top: min(5rem, calc(2rem + 4vw));
  }

  .awj-card {
    padding: 30px 25px;
    border-radius: 16px;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-foreground) / 0.1);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Card inverts to black with white text on hover.
     Lift comes from box-shadow (not translateY) so the card never moves out
     from under the cursor at its edges — that movement caused the hover jitter. */
  .awj-card:hover {
    background: rgb(var(--color-foreground));
    box-shadow: 0 12px 30px rgb(var(--color-foreground) / 0.18);
  }

  .awj-card:hover .awj-card__title,
  .awj-card:hover .awj-card__desc {
    color: rgb(var(--color-background));
  }

  /* Icon badge — black tile that flips to gold on hover (matches "Why join").
     Layout via utilities: .inline-flex .items-center .justify-center .mb-5 */
  .awj-card__icon {
    width: 54px;
    height: 54px;
    padding: 12px;
    border-radius: 14px;
    background: rgb(var(--color-foreground));
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .awj-card__icon img {
    transition: filter 0.3s ease;
    filter: brightness(0) invert(1);
  }

  .awj-card:hover .awj-card__icon {
    background: rgb(var(--awj-accent-rgb));
    transform: scale(1.05);
  }

  /* Uploaded icon turns white on hover */
  .awj-card:hover .awj-card__icon img {
    filter: brightness(0) invert(0);
  }

  .awj-card__title {
    margin-bottom: 10px;
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }

  .awj-card__desc {
    line-height: 1.7;
    color: rgb(var(--color-foreground) / 0.65);
  }

  @media (max-width: 600px) {
    .awj-grid { grid-template-columns: 1fr; }
    /* Single column — the lone last card no longer needs special centring */
    .awj-card:last-child:nth-child(odd) {
      grid-column: auto;
      max-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "Partnership",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_horizontal_space",
      "label": "t:sections.apps.settings.remove_horizontal_space.label"
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_space",
      "label": "t:sections.apps.settings.remove_vertical_space.label"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.rich-text.settings.content_width.label",
      "options": [
        { "value": "small", "label": "t:sections.rich-text.settings.content_width.options__0.label" },
        { "value": "normal", "label": "t:sections.rich-text.settings.content_width.options__1.label" },
        { "value": "large", "label": "t:sections.rich-text.settings.content_width.options__2.label" },
        { "value": "extra-large", "label": "t:sections.rich-text.settings.content_width.options__3.label" },
        { "value": "full-width", "label": "t:sections.rich-text.settings.content_width.options__4.label" }
      ],
      "default": "large"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c9a96e"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "Why Join"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label",
      "default": "A simple way to earn by sharing calm."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:sections.all.content.label",
      "default": "<p>Breathelet is made for creators, wellness voices, mindfulness communities, and everyday people who believe better habits should feel simple, beautiful, and screen-free.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.text_alignment.label",
      "options": [
        { "value": "text-left", "label": "t:sections.all.text_alignment.options.text_left.label" },
        { "value": "text-center", "label": "t:sections.all.text_alignment.options.text_center.label" }
      ],
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        { "value": "h0", "label": "t:sections.all.heading_size.options__0.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h2", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h3", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "h4", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "h5", "label": "t:sections.all.heading_size.options__5.label" },
        { "value": "h6", "label": "t:sections.all.heading_size.options__6.label" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_html_tag",
      "label": "t:sections.all.heading_html_tag.label",
      "options": [
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" },
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2",
      "info": "t:sections.all.heading_html_tag.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "label": "t:sections.all.text_color.label",
      "id": "text_color"
    },
    {
      "type": "color",
      "label": "t:sections.all.heading_color.label",
      "id": "heading_color"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 9,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "range",
          "id": "icon_width",
          "label": "Icon width",
          "min": 24,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 48
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Describe this benefit in a sentence or two.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Partnership",
      "category": "Wholesale",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Monthly Commissions", "text": "<p>Earn commission for every valid sale you generate through your Wholesale link or discount code.</p>" } },
        { "type": "benefit", "settings": { "title": "No Minimum Payout", "text": "<p>No waiting around for a payout threshold. Once you earn it, you can get paid monthly.</p>" } },
        { "type": "benefit", "settings": { "title": "Easy To Promote", "text": "<p>Share a product built around mindfulness, stress relief, better breathing, and screen-free calm.</p>" } },
        { "type": "benefit", "settings": { "title": "Auto-Tracked Sales", "text": "<p>Your referrals are tracked automatically through your link or code, because manual tracking is where joy goes to die.</p>" } },
        { "type": "benefit", "settings": { "title": "Marketing Support", "text": "<p>Get access to product messaging and promotional support to help you share Breathelet with confidence.</p>" } },
        { "type": "benefit", "settings": { "title": "Real Product Appeal", "text": "<p>Promote a wearable mindfulness product that looks premium, feels intentional, and fits modern wellness routines.</p>" } }
      ]
    }
  ]
}
{% endschema %}
