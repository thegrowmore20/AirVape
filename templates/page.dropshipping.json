    "faq_accordion_i7RJpN": {
      "type": "faq-accordion",
      "blocks": {
        "faqs_n8TCkT": {
          "type": "faqs",
          "settings": {
            "quiz": "Do you officially support dropshipping?",
            "answer": "<p>Yes. We officially support dropshipping for <strong>approved business partners only</strong>. Dropshipping services are available subject to account approval, product availability, and compliance with our reseller terms.</p>"
          }
        },
        "faqs_8HWjiT": {
          "type": "faqs",
          "settings": {
            "quiz": "How does the dropshipping service work?",
            "answer": "<p>Approved partners may market and sell our products through their own sales channels. Once an end-customer order is received, the partner submits the order details to us for fulfillment. We ship directly to the end customer on the partner’s behalf.</p>"
          }
        },
        "faqs_HNbAtn": {
          "type": "faqs",
          "settings": {
            "quiz": "What is the dropshipping process?",
            "answer": "<p>The process works as follows:</p><ul><li>Partner approval is completed</li><li>Approved products are listed by the partner</li><li>The partner submits paid customer orders to us</li><li>We process and dispatch the order</li><li>Tracking information is shared after shipment</li></ul>"
          }
        },
        "faqs_X7dcTz": {
          "type": "faqs",
          "settings": {
            "quiz": "How does the order process flow, from placement to fulfillment?",
            "answer": "<p>The partner is responsible for collecting the customer order and payment through their own platform. After receiving the order, the partner submits complete shipping details to us. We then process, pack, and dispatch the order. Fulfillment begins only after order confirmation and acceptance by our team.</p>"
          }
        },
        "faqs_ieJMMH": {
          "type": "faqs",
          "settings": {
            "quiz": "What are the shipping times for dropshipping orders?",
            "answer": "<p>Shipping timelines vary based on stock availability, order volume, destination country, courier service, and customs procedures. Processing and transit times are estimates only and are not guaranteed unless agreed in writing.</p>"
          }
        },
        "faqs_EzqiUU": {
          "type": "faqs",
          "settings": {
            "quiz": "Which regions do you ship to?",
            "answer": "<p>We ship to selected domestic and international regions where courier service is available. Some destinations may be restricted due to shipping limitations, customs regulations, or commercial policy.</p>"
          }
        },
        "faqs_iWzmgj": {
          "type": "faqs",
          "settings": {
            "quiz": "How are returns and refunds handled for dropshipping orders?",
            "answer": "<p>Returns and refunds are handled according to our approved return policy. Claims for damaged, defective, or incorrect items must be reported within the stated claim period with photo or video evidence. No return, refund, or replacement will be processed without prior approval.</p>"
          }
        },
        "faqs_4PeryU": {
          "type": "faqs",
          "settings": {
            "quiz": "Are all returns accepted?",
            "answer": "<p>No. Unauthorized returns, used items, customer-damaged items, and claims made outside the approved reporting period may be rejected. Refund approval remains subject to inspection and policy compliance.</p>"
          }
        },
        "faqs_47Dwfc": {
          "type": "faqs",
          "settings": {
            "quiz": "Ready to Start Dropshipping With AirVape?",
            "answer": "<p>Apply to become an approved dropshipping partner and explore a fulfillment-supported way to sell AirVape products through your own sales channels.</p>"
          }
        }
      },
