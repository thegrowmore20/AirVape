    "affiliate_why_join_EaqGLq": {
      "type": "affiliate-why-join",
      "blocks": {
        "benefit_UzXPQp": {
          "type": "benefit",
          "settings": {
            "icon_type": "svg",
            "icon": "commission",
            "icon_width": 48,
            "custom_svg": "",
            "title": "Shipping Times",
            "text": "<p>Processing and transit times are <strong>estimates only</strong> and are <strong>not guaranteed unless agreed in writing</strong>.<br/><br/>Shipping timelines vary based on:</p>",
            "tag_1": "Stock availability",
            "tag_2": "Order volume",
            "tag_3": "Destination country",
            "tag_4": "Courier service",
            "tag_5": "Customs procedures"
          }
        },
        "benefit_YKCdeW": {
          "type": "benefit",
          "settings": {
            "icon_type": "svg",
            "icon": "payout",
            "icon_width": 48,
            "custom_svg": "",
            "title": "Shipping Regions",
            "text": "<p>Exact shipping availability can be confirmed based on the destination and order details.<br/><br/>We ship to selected domestic and international regions where courier service is available.</p><p>Some destinations may be restricted due to:</p>",
            "tag_1": "Shipping limitations",
            "tag_2": "Customs regulations",
            "tag_3": "Commercial policy",
            "tag_4": "Product restrictions in certain markets",
            "tag_5": ""
          }
        }
      },
