          "settings": {
            "icon_type": "svg",
            "icon": "commission",
            "icon_width": 48,
            "custom_svg": "",
            "title": "Returns & Refunds",
            "text": "<p>Returns and refunds for dropshipping orders are handled according to our approved return policy.</p><p>Claims for <strong>damaged, defective, or incorrect items</strong> must be reported within the approved claim period and must include <strong>photo or video evidence</strong> for review.<br/><br/><strong>NOTE:</strong> No return, refund, or replacement will be processed without prior approval.</p>",
            "tag_1": "",
            "tag_2": "",
            "tag_3": "",
            "tag_4": "",
            "tag_5": ""
          }
        },
        "benefit_P77djY": {
          "type": "benefit",
          "settings": {
            "icon_type": "svg",
            "icon": "payout",
            "icon_width": 48,
            "custom_svg": "",
            "title": "Return Restrictions",
            "text": "<p>Not all returns are accepted. The following may be rejected:</p><ul><li>Unauthorized returns</li><li>Used items</li><li>Customer-damaged items</li><li>Claims submitted outside the approved reporting period</li></ul><p>Refund or replacement approval remains subject to inspection and policy compliance.</p>",
            "tag_1": "",
            "tag_2": "",
            "tag_3": "",
            "tag_4": "",
            "tag_5": ""
          }
        }
      },
