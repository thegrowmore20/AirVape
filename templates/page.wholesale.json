      "blocks": {
        "faqs_MLQNid": {
          "type": "faqs",
          "settings": {
            "quiz": "What is the MOQ for wholesale orders? Does it vary by product?",
            "answer": "<p>Yes. The MOQ can vary by product. Standard products may have a lower MOQ, while customized or branded orders may require a higher minimum quantity. Our wholesale MOQ depends on the product type, packaging requirements, and shipping destination. Please contact us with your product details so we can confirm the exact MOQ.</p>"
          }
        },
        "faqs_9RkAqF": {
          "type": "faqs",
          "settings": {
            "quiz": "Are there bulk pricing or discount tiers for larger orders?",
            "answer": "<p>Yes. Our pricing is typically structured in tiers, so the higher the quantity, the more competitive the unit price becomes. Final pricing depends on the specific products, quantities, and any customization requirements.</p>"
          }
        },
        "faqs_QNYwxD": {
          "type": "faqs",
          "settings": {
            "quiz": "What regions do you ship to, and what are the delivery times?",
            "answer": "<p>We can ship to many countries worldwide. Estimated delivery times vary by region and may also depend on customs clearance, order preparation time, and the shipping method selected. Exact timelines can be shared once we review your order requirements and delivery location.</p>"
          }
        },
        "faqs_g7HhEp": {
          "type": "faqs",
          "settings": {
            "quiz": "Do you provide marketing support or materials?",
            "answer": "<p>Yes. Approved wholesale partners can receive selected marketing materials such as available product images, basic descriptions, specifications, and key product information to support sales and promotion.</p>"
          }
        },
        "faqs_QtFjPQ": {
          "type": "faqs",
          "settings": {
            "quiz": "Can both businesses and individuals apply for wholesale?",
            "answer": "<p>Yes. Businesses can apply for wholesale directly. Individuals may also apply, but approval depends on the order volume, sales channel, and business intent. Business applicants are generally preferred for long-term wholesale partnerships.</p>"
          }
        },
        "faqs_67MHKQ": {
          "type": "faqs",
          "settings": {
            "quiz": "What documents may be required for wholesale setup?",
            "answer": "<p>Businesses may be asked to provide basic company and trade information, including business name and contact details, company registration or trade license, tax or VAT certificate where applicable, shipping and billing address, sales channel details, product interest, and estimated order quantity.</p>"
          }
        },
        "faqs_wdFgKV": {
