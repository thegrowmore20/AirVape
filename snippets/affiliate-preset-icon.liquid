{%- comment -%}
  Renders a preset inline SVG icon, shared by the affiliate/wholesale card sections.

  Usage:
    {% render 'affiliate-preset-icon', icon: block.settings.icon %}

  All paths use stroke/fill="currentColor" so the icon inherits the surrounding
  colour (and any hover colour change) from its wrapper.
{%- endcomment -%}

{%- case icon -%}
  {%- when 'commission' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 1.5v21M17 5.5H9.5A3.5 3.5 0 0 0 9.5 12.5h5a3.5 3.5 0 0 1 0 7H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'tracking' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M3 20V10M9 20V4M15 20v-7M21 20V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'nominimum' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.6"/>
      <path d="m8 8 8 8M16 8l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'link' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M9.5 14.5 14.5 9.5M10.5 6.5l1.4-1.4a4 4 0 0 1 5.6 5.6l-1.4 1.4M13.5 17.5l-1.4 1.4a4 4 0 0 1-5.6-5.6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'support' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M4 5h13a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-4 3.5V16H4a1 1 0 0 1-1-1V7a2 2 0 0 1 1-2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M8 9.5h7M8 12.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'product' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 2.5 4 6.5v6c0 5 3.4 7.9 8 9 4.6-1.1 8-4 8-9v-6l-8-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="m9 12 2.2 2.2L15.5 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'payout' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="2.75" y="6.75" width="18.5" height="12.5" rx="2" stroke="currentColor" stroke-width="1.6"/>
      <path d="M2.75 10.5h18.5" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="17" cy="14.5" r="1.4" fill="currentColor"/>
    </svg>
  {%- when 'promote' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M3.5 9.5v5a1 1 0 0 0 1 1H8l7 4.5V4L8 8.5H4.5a1 1 0 0 0-1 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M18.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.6"/>
      <path d="m8 12.3 2.6 2.6L16 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'users' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="9" cy="8" r="3.25" stroke="currentColor" stroke-width="1.6"/>
      <path d="M2.75 19.5a6.25 6.25 0 0 1 12.5 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M16.5 5.75a3 3 0 0 1 0 5.5M18.75 19.5a5.5 5.5 0 0 0-2.6-4.65" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
